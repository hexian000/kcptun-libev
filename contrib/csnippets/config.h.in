#ifndef CSNIPPETS_CONFIG_H
#define CSNIPPETS_CONFIG_H

#cmakedefine01 HAVE_CLOCK_GETTIME
#cmakedefine01 HAVE_TIMESPEC_GET
#cmakedefine01 HAVE_SYSLOG
#cmakedefine01 HAVE_GMTIME_R
#cmakedefine01 HAVE_LOCALTIME_R
#cmakedefine01 HAVE_WCWIDTH
#cmakedefine01 HAVE_BACKTRACE
#cmakedefine01 HAVE_BACKTRACE_SYMBOLS

#cmakedefine01 WITH_LIBBACKTRACE
#cmakedefine01 WITH_LIBUNWIND
#cmakedefine01 WITH_DEBUGINFO
#cmakedefine01 WITH_SYSTEMD

/* Upstream can back the strings/ Unicode utilities with libicu; this project
 * does not link libicu, so WITH_ICU stays off and the utf8 codec uses its
 * self-contained backend. */
#cmakedefine01 WITH_ICU

#endif /* CSNIPPETS_CONFIG_H */
